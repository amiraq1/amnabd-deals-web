# Copy to `.env.local` (ignored by git) and fill in real values.
# Both values are PUBLIC: they are compiled into the browser bundle.
# Never put a service_role key or an `sb_secret_` key here — the build rejects it.

# Project URL, HTTPS only, no credentials / query / hash.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Either an anon JWT (`role: anon`) or a publishable key (`sb_publishable_...`).
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_me

# Optional: absolute site URL used by the post-build SEO generator.
# Defaults to https://amnabd.com
# SITE_URL=https://example.com
